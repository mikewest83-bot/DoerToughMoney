{
  "name": "doertoughmoney-server",
  "version": "2.0.0",
  "type": "module",
  "description": "DoerToughMoney — personal finance backend (accounts, transactions, bills, budgets, goals via Plaid, + DealTough savings integration). No money movement — auth + shared-expense tracking are the only things that touch other people.",
  "main": "server.js",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "start": "prisma migrate deploy && node server.js",
    "dev": "node --watch server.js",
    "migrate": "prisma migrate dev",
    "studio": "prisma studio",
    "test": "vitest run",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "@simplewebauthn/server": "^13.3.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.0",
    "google-auth-library": "^10.9.1",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "plaid": "^30.1.0",
    "prisma": "^5.19.0"
  },
  "devDependencies": {
    "vitest": "^2.1.1"
  }
}
