generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GroupType {
  HOUSEHOLD
  TRIP
  TEAM
  OTHER
}

enum SplitMode {
  EQUAL
  EXACT
}

enum RecurrenceInterval {
  WEEKLY
  MONTHLY
}

// A Plaid Item's own health, surfaced from ITEM_LOGIN_REQUIRED / error
// webhooks so the UI can prompt a reconnect instead of silently going stale.
enum PlaidItemStatus {
  ACTIVE
  ERROR
  REAUTH_REQUIRED
}

enum BillCadence {
  WEEKLY
  MONTHLY
  YEARLY
  UNKNOWN
}

// Mirrors Stripe's own subscription statuses, collapsed to what the app
// actually needs to branch on. PAST_DUE still keeps paid-tier access (Stripe
// is mid-retry, not yet given up) — only CANCELED/NONE lock it.
enum SubscriptionStatus {
  NONE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

model User {
  id           String   @id @default(cuid())
  name         String
  handle       String   @unique
  email        String   @unique
  // Null for a Google-only account — nothing to type in, so nothing to hash.
  passwordHash String?
  // Google's `sub` claim. Set on Google sign-up, or on first Google sign-in for
  // an existing password account whose email Google has verified matches.
  googleId     String?  @unique
  createdAt    DateTime @default(now())

  // ── billing (Stripe subscriptions — card billing only, never touches
  // money owed between users; see stripe.js) ──
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  subscriptionStatus   SubscriptionStatus @default(NONE)
  // Free-form on purpose — which price/plan maps to which tier lives in
  // Stripe, not hardcoded here. Null while status isn't ACTIVE/TRIALING.
  subscriptionTier     String?
  currentPeriodEnd     DateTime?

  groupMemberships GroupMember[]
  createdGroups    Group[]
  credentials      Credential[]

  plaidItems   PlaidItem[]
  accounts     Account[]
  transactions Transaction[]
  bills        Bill[]
  budgets      Budget[]
  goals        Goal[]
}

// A passkey (WebAuthn credential) enrolled on one of this user's devices.
// Discoverable/usernameless — sign-in doesn't ask for an identifier first, the
// browser offers whatever passkey it holds for this domain, and this table is
// how that credential ID resolves back to an account.
model Credential {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  credentialId String   @unique // base64url id the browser returns each sign-in
  publicKey    Bytes
  counter      BigInt   @default(0) // replay-attack guard; must strictly increase
  transports   String[] @default([]) // e.g. ["internal"] for a platform authenticator
  deviceLabel  String? // e.g. "iPhone", set from the browser at enrollment time
  createdAt    DateTime @default(now())

  @@index([userId])
}

// ── DoerToughMoney: linked banks, balances, transactions ────
// One PlaidItem per bank login (Plaid's unit of a linked institution); each
// Item can expose several Accounts (checking, savings, credit card, ...).
model PlaidItem {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id])
  plaidItemId     String          @unique // Plaid's item_id
  // Plaid access_token for this Item. TODO before going live with real user
  // data: encrypt this at rest (e.g. envelope-encrypt with a KMS key) rather
  // than storing it as plaintext — it's a bearer credential for the user's
  // bank data for as long as the Item stays connected.
  accessToken     String
  institutionId   String?
  institutionName String?
  // Flipped to REAUTH_REQUIRED by Plaid's ITEM_LOGIN_REQUIRED webhook (bank
  // password changed, MFA expired) so the UI can prompt a reconnect instead of
  // silently failing every subsequent sync.
  status          PlaidItemStatus @default(ACTIVE)
  // Cursor for Plaid's /transactions/sync — persisted between syncs so each
  // call only fetches what changed since last time instead of the full history.
  transactionsCursor String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  accounts Account[]

  @@index([userId])
}

model Account {
  id                     String    @id @default(cuid())
  userId                 String
  user                   User      @relation(fields: [userId], references: [id])
  plaidItemId            String
  plaidItem              PlaidItem @relation(fields: [plaidItemId], references: [id], onDelete: Cascade)
  plaidAccountId         String    @unique
  name                   String
  officialName           String?
  mask                   String? // last 4 digits, for display
  // Plaid's own account_type: "depository" | "credit" | "loan" | "investment" | "other"
  type                   String
  subtype                String? // e.g. "checking", "savings", "credit card"
  currentBalanceCents    Int?
  availableBalanceCents  Int?
  isoCurrencyCode        String    @default("USD")
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  transactions Transaction[]

  @@index([userId])
  @@index([plaidItemId])
}

// A recurring, known expense — rent, insurance, subscriptions — either
// auto-detected from transaction history or entered by hand. This is the
// anchor point for the DealTough integration: "this bill looks negotiable"
// hangs off a Bill, not a raw transaction, so a suggestion survives even as
// new matching transactions come in month to month.
model Bill {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  name         String
  category     String?
  amountCents  Int // typical/estimated amount
  cadence      BillCadence @default(UNKNOWN)
  nextDueOn    DateTime?
  // True when this row was created by the recurring-bill detector matching
  // repeated transactions, rather than entered by hand.
  autoDetected Boolean     @default(false)
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  transactions Transaction[]

  @@index([userId])
}

model Transaction {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  accountId          String
  account            Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // Null for a manually-entered transaction; set for anything synced from Plaid.
  plaidTransactionId String?  @unique
  // Plaid convention: positive = money OUT of the account, negative = money IN.
  amountCents        Int
  isoCurrencyCode    String   @default("USD")
  date               DateTime
  name               String // raw description from the bank/Plaid
  merchantName       String?
  category           String? // Plaid's top-level personal-finance category
  pending            Boolean  @default(false)
  billId             String?
  bill               Bill?    @relation(fields: [billId], references: [id])
  createdAt          DateTime @default(now())

  @@index([userId, date])
  @@index([accountId])
  @@index([billId])
}

model Budget {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  category          String
  monthlyLimitCents Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, category])
  @@index([userId])
}

model Goal {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  name         String
  targetCents  Int
  currentCents Int       @default(0)
  targetDate   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
}

// ── shared expenses ──────────────────────────────────────
// A household, trip, team, or an implicit 2-person pair. Debts here are
// tracked data, not custody — DoerToughMoney never holds or moves anyone
// else's money. Balances are computed from expenses and settlements (see
// groups.js) and squared up with a cash record, not a bank transfer.
model Group {
  id          String    @id @default(cuid())
  name        String
  type        GroupType @default(HOUSEHOLD)
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  // True for the auto-created 2-person group behind a direct "split with Sam",
  // so the UI can present it as a person rather than a named group.
  implicit    Boolean   @default(false)
  createdAt   DateTime  @default(now())

  members     GroupMember[]
  expenses    Expense[]
  recurring   RecurringExpense[]
  settlements Settlement[]
  reminders   Reminder[]

  @@index([createdById])
}

// A member is either a real user, or a placeholder for someone invited by email
// who hasn't signed up yet. Expenses reference members (not users) precisely so
// a placeholder can hold a share before they have an account — that's what lets
// a household start tracking immediately and pulls invitees in.
model GroupMember {
  id          String    @id @default(cuid())
  groupId     String
  group       Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  inviteEmail String?   // set while pending; matched on registration
  inviteName  String?   // display name until they join
  joinedAt    DateTime?
  createdAt   DateTime  @default(now())

  paidExpenses      Expense[]          @relation("paidBy")
  shares            ExpenseShare[]
  paidRecurring     RecurringExpense[] @relation("recurringPaidBy")
  settlementsFrom   Settlement[]       @relation("settleFrom")
  settlementsTo     Settlement[]       @relation("settleTo")
  remindersSent     Reminder[]         @relation("remindFrom")
  remindersReceived Reminder[]         @relation("remindTo")

  @@unique([groupId, userId])
  @@unique([groupId, inviteEmail])
  @@index([groupId])
  @@index([userId])
  @@index([inviteEmail])
}

model Expense {
  id             String    @id @default(cuid())
  groupId        String
  group          Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidByMemberId String
  paidBy         GroupMember @relation("paidBy", fields: [paidByMemberId], references: [id])
  amountCents    Int
  description    String
  splitMode      SplitMode @default(EQUAL)
  incurredOn     DateTime  @default(now())
  createdById    String
  // Set when this row was materialized from a schedule, plus the period it
  // covers — the unique constraint is what stops a re-run charging rent twice.
  recurringExpenseId String?
  recurringPeriod    String?
  recurringExpense   RecurringExpense? @relation(fields: [recurringExpenseId], references: [id])
  createdAt      DateTime  @default(now())

  shares ExpenseShare[]

  @@unique([recurringExpenseId, recurringPeriod])
  @@index([groupId])
  @@index([paidByMemberId])
}

model ExpenseShare {
  id         String      @id @default(cuid())
  expenseId  String
  expense    Expense     @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  memberId   String
  member     GroupMember @relation(fields: [memberId], references: [id])
  shareCents Int

  @@unique([expenseId, memberId])
  @@index([memberId])
}

// Rent on the 1st, Netflix monthly. Materialized into Expense rows by the daily
// job in recurring.js so nobody re-enters them every month.
model RecurringExpense {
  id             String             @id @default(cuid())
  groupId        String
  group          Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidByMemberId String
  paidBy         GroupMember        @relation("recurringPaidBy", fields: [paidByMemberId], references: [id])
  amountCents    Int
  description    String
  splitMode      SplitMode          @default(EQUAL)
  interval       RecurrenceInterval
  dayOfMonth     Int?               // MONTHLY, capped at 28 so February never skips
  dayOfWeek      Int?               // WEEKLY, 0=Sunday
  nextRunOn      DateTime
  active         Boolean            @default(true)
  createdAt      DateTime           @default(now())

  expenses Expense[]

  @@index([groupId])
  @@index([active, nextRunOn])
}

// A cash record of two members squaring up — DoerToughMoney doesn't move
// money on anyone's behalf, so this is bookkeeping only, not a transfer.
model Settlement {
  id           String      @id @default(cuid())
  groupId      String
  group        Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromMemberId String
  fromMember   GroupMember @relation("settleFrom", fields: [fromMemberId], references: [id])
  toMemberId   String
  toMember     GroupMember @relation("settleTo", fields: [toMemberId], references: [id])
  amountCents  Int
  createdAt    DateTime    @default(now())

  @@index([groupId])
}

// A nudge from someone who is owed money to the person who owes it. Delivered
// in-app only — DoerToughMoney sends nothing outbound on a user's behalf.
// amountCents is snapshotted at send time so the reminder still reads
// truthfully later, even after the underlying balance moves.
model Reminder {
  id           String      @id @default(cuid())
  groupId      String
  group        Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromMemberId String
  fromMember   GroupMember @relation("remindFrom", fields: [fromMemberId], references: [id])
  toMemberId   String
  toMember     GroupMember @relation("remindTo", fields: [toMemberId], references: [id])
  amountCents  Int
  note         String?
  seenAt       DateTime?
  createdAt    DateTime    @default(now())

  @@index([groupId])
  // Serves both "what's waiting for me" and the cooldown lookup.
  @@index([toMemberId, createdAt])
  @@index([fromMemberId, toMemberId, createdAt])
}

// Makes mutating routes safe to retry: a client sends an Idempotency-Key
// header; the same key replays the stored response instead of double-posting.
model IdempotencyKey {
  id        String   @id @default(cuid())
  key       String
  userId    String
  status    Int      @default(0) // 0 = in progress, else the HTTP status
  response  Json
  createdAt DateTime @default(now())

  @@unique([userId, key])
}
