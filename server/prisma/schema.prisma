generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum KycStatus {
  PENDING
  VERIFIED
  RETRY
  DOCUMENT
  SUSPENDED
}

enum TransferStatus {
  PENDING
  POSTED
  FAILED
  RETURNED
}

// STANDARD  — plain ACH both legs: ~3-4 business days to debit, 1-2 to credit.
// EXPRESS   — Same Day ACH on the debit, and Instant Payments (RTP/FedNow) on
//             the credit when the recipient's bank supports it, else Same Day
//             ACH there too. Carries the expedite fee.
enum TransferSpeed {
  STANDARD
  EXPRESS
}

enum GroupType {
  HOUSEHOLD
  TRIP
  TEAM
  OTHER
}

enum SplitMode {
  EQUAL
  EXACT
}

enum RecurrenceInterval {
  WEEKLY
  MONTHLY
}

enum DisputeStatus {
  FILED
  INVESTIGATING
  PROVISIONAL_CREDIT_ISSUED
  RESOLVED_UPHELD
  RESOLVED_DENIED
}

model User {
  id                    String    @id @default(cuid())
  name                  String
  handle                String    @unique
  email                 String    @unique
  passwordHash          String
  dwollaCustomerUrl     String?   @unique
  kycStatus             KycStatus @default(PENDING)
  fundingSourceUrl      String?
  fundingSourceVerified Boolean   @default(false)
  // Processing channels the linked bank supports, straight from Dwolla, e.g.
  // ["ach"] or ["ach","real-time-payments"]. Presence of real-time-payments
  // means this account can receive Instant Payments.
  fundingSourceChannels String[]  @default([])
  createdAt             DateTime  @default(now())

  sentTransfers     Transfer[] @relation("sender")
  receivedTransfers Transfer[] @relation("recipient")
  sentRequests      Request[]  @relation("payer")
  receivedRequests  Request[]  @relation("requester")
  disputes          Dispute[]
  groupMemberships  GroupMember[]
  createdGroups     Group[]
}

// even's record of money movement. No in-app spendable balance — funds live
// in users' own banks; this is an auditable transfer + fee record, not custody.
// Status is always driven by Dwolla events (webhook / reconcile), never guessed.
model Transfer {
  id             String         @id @default(cuid())
  idempotencyKey String         @unique
  providerRef    String         @unique // Dwolla transfer id (matches webhook resourceId)
  providerUrl    String                  // full Dwolla transfer URL (for reconcile)
  senderId       String
  recipientId    String
  sender         User           @relation("sender", fields: [senderId], references: [id])
  recipient      User           @relation("recipient", fields: [recipientId], references: [id])
  amountCents    Int
  // Total facilitator fee charged to the sender (platform + expedite).
  feeCents       Int            @default(0)
  // The portion of feeCents that was for faster delivery, for reporting.
  expediteFeeCents Int          @default(0)
  feeCollected   Boolean        @default(false)
  note           String?
  speed          TransferSpeed  @default(STANDARD)
  status         TransferStatus @default(PENDING)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  disputes       Dispute[]
  settlement     Settlement?

  @@index([senderId])
  @@index([recipientId])
}

// Regulation E dispute record. Reg E imposes hard deadlines on consumer EFT
// disputes: investigate within 10 business days, or issue provisional credit
// and take up to 45 calendar days total. investigationDueAt/finalDueAt encode
// those deadlines so the daily sweep in dwolla/disputes.js can enforce them.
model Dispute {
  id                  String        @id @default(cuid())
  transferId          String
  transfer            Transfer      @relation(fields: [transferId], references: [id])
  userId              String
  user                User          @relation(fields: [userId], references: [id])
  amountCents         Int
  reason              String
  status              DisputeStatus @default(FILED)
  filedAt             DateTime      @default(now())
  investigationDueAt  DateTime      // filedAt + 10 business days
  provisionalCreditAt DateTime?     // set when provisional credit is issued
  finalDueAt          DateTime?     // filedAt + 45 calendar days
  resolvedAt          DateTime?
  resolutionNote      String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([transferId])
  @@index([userId])
  @@index([status])
}

// A non-money "please pay me" note. No Dwolla involvement — purely informational
// until the requester follows up with an actual Pay.
model Request {
  id          String   @id @default(cuid())
  payerId     String
  requesterId String
  payer       User     @relation("payer", fields: [payerId], references: [id])
  requester   User     @relation("requester", fields: [requesterId], references: [id])
  amountCents Int
  note        String?
  createdAt   DateTime @default(now())

  @@index([payerId])
  @@index([requesterId])
}

// ── shared expenses ──────────────────────────────────────
// A household, trip, team, or an implicit 2-person pair. Debts here are tracked
// data, not custody: even never holds the money. Balances are computed from
// expenses and settlements (see groups.js) and squared up with a real transfer.
model Group {
  id          String    @id @default(cuid())
  name        String
  type        GroupType @default(HOUSEHOLD)
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  // True for the auto-created 2-person group behind a direct "split with Sam",
  // so the UI can present it as a person rather than a named group.
  implicit    Boolean   @default(false)
  createdAt   DateTime  @default(now())

  members    GroupMember[]
  expenses   Expense[]
  recurring  RecurringExpense[]
  settlements Settlement[]
  reminders   Reminder[]

  @@index([createdById])
}

// A member is either a real user, or a placeholder for someone invited by email
// who hasn't signed up yet. Expenses reference members (not users) precisely so
// a placeholder can hold a share before they have an account — that's what lets
// a household start tracking immediately and pulls invitees in.
model GroupMember {
  id          String    @id @default(cuid())
  groupId     String
  group       Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  inviteEmail String?   // set while pending; matched on registration
  inviteName  String?   // display name until they join
  joinedAt    DateTime?
  createdAt   DateTime  @default(now())

  paidExpenses     Expense[]      @relation("paidBy")
  shares           ExpenseShare[]
  paidRecurring    RecurringExpense[] @relation("recurringPaidBy")
  settlementsFrom  Settlement[]   @relation("settleFrom")
  settlementsTo    Settlement[]   @relation("settleTo")
  remindersSent     Reminder[]    @relation("remindFrom")
  remindersReceived Reminder[]    @relation("remindTo")

  @@unique([groupId, userId])
  @@unique([groupId, inviteEmail])
  @@index([groupId])
  @@index([userId])
  @@index([inviteEmail])
}

model Expense {
  id             String    @id @default(cuid())
  groupId        String
  group          Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidByMemberId String
  paidBy         GroupMember @relation("paidBy", fields: [paidByMemberId], references: [id])
  amountCents    Int
  description    String
  splitMode      SplitMode @default(EQUAL)
  incurredOn     DateTime  @default(now())
  createdById    String
  // Set when this row was materialized from a schedule, plus the period it
  // covers — the unique constraint is what stops a re-run charging rent twice.
  recurringExpenseId String?
  recurringPeriod    String?
  recurringExpense   RecurringExpense? @relation(fields: [recurringExpenseId], references: [id])
  createdAt      DateTime  @default(now())

  shares ExpenseShare[]

  @@unique([recurringExpenseId, recurringPeriod])
  @@index([groupId])
  @@index([paidByMemberId])
}

model ExpenseShare {
  id         String      @id @default(cuid())
  expenseId  String
  expense    Expense     @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  memberId   String
  member     GroupMember @relation(fields: [memberId], references: [id])
  shareCents Int

  @@unique([expenseId, memberId])
  @@index([memberId])
}

// Rent on the 1st, Netflix monthly. Materialized into Expense rows by the daily
// job in recurring.js so nobody re-enters rent every month.
model RecurringExpense {
  id             String             @id @default(cuid())
  groupId        String
  group          Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidByMemberId String
  paidBy         GroupMember        @relation("recurringPaidBy", fields: [paidByMemberId], references: [id])
  amountCents    Int
  description    String
  splitMode      SplitMode          @default(EQUAL)
  interval       RecurrenceInterval
  dayOfMonth     Int?               // MONTHLY, capped at 28 so February never skips
  dayOfWeek      Int?               // WEEKLY, 0=Sunday
  nextRunOn      DateTime
  active         Boolean            @default(true)
  createdAt      DateTime           @default(now())

  expenses Expense[]

  @@index([groupId])
  @@index([active, nextRunOn])
}

// Either a real transfer through even, or a record that two people squared up in
// cash. Both have to reduce the balance, which is why this isn't just a flag on
// Transfer — cash settlements have no transfer at all.
model Settlement {
  id           String      @id @default(cuid())
  groupId      String
  group        Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromMemberId String
  fromMember   GroupMember @relation("settleFrom", fields: [fromMemberId], references: [id])
  toMemberId   String
  toMember     GroupMember @relation("settleTo", fields: [toMemberId], references: [id])
  amountCents  Int
  transferId   String?     @unique
  transfer     Transfer?   @relation(fields: [transferId], references: [id])
  createdAt    DateTime    @default(now())

  @@index([groupId])
}

// A nudge from someone who is owed money to the person who owes it. Delivered
// in-app only — even sends nothing outbound on a user's behalf. amountCents is
// snapshotted at send time so the reminder still reads truthfully later, even
// after the underlying balance moves.
model Reminder {
  id           String      @id @default(cuid())
  groupId      String
  group        Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromMemberId String
  fromMember   GroupMember @relation("remindFrom", fields: [fromMemberId], references: [id])
  toMemberId   String
  toMember     GroupMember @relation("remindTo", fields: [toMemberId], references: [id])
  amountCents  Int
  note         String?
  seenAt       DateTime?
  createdAt    DateTime    @default(now())

  @@index([groupId])
  // Serves both "what's waiting for me" and the cooldown lookup.
  @@index([toMemberId, createdAt])
  @@index([fromMemberId, toMemberId, createdAt])
}

// Makes mutating money endpoints safe to retry: a client sends an
// Idempotency-Key header; the same key replays the stored response
// instead of moving money twice.
model IdempotencyKey {
  id        String   @id @default(cuid())
  key       String
  userId    String
  status    Int      @default(0) // 0 = in progress, else the HTTP status
  response  Json
  createdAt DateTime @default(now())

  @@unique([userId, key])
}

