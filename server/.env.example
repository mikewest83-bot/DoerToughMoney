# ── Server ──────────────────────────────────────────────
PORT=4000
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
WEB_ORIGIN=http://localhost:5173

# ── Database (Postgres) ─────────────────────────────────
# Local docker:  docker run --name dtm-pg -e POSTGRES_PASSWORD=pg -p 5432:5432 -d postgres:16
# Then:          DATABASE_URL="postgresql://postgres:pg@localhost:5432/doertoughmoney?schema=public"
# On Railway this is provided automatically by the Postgres plugin.
DATABASE_URL=postgresql://postgres:pg@localhost:5432/doertoughmoney?schema=public

# ── Linked banks (Plaid) ─────────────────────────────────
# Keys from https://dashboard.plaid.com/team/keys
PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_secret_here
PLAID_ENV=sandbox              # "production" once approved for real bank data

# Plaid access-token encryption
# REQUIRED before production bank data is enabled.
# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Store the real value ONLY in Railway environment variables.
PLAID_TOKEN_ENCRYPTION_KEY=

# Optional but recommended once the service has a public domain — lets Plaid
# push item/transaction updates instead of relying only on manual refresh.
# Must point at THIS service's own /webhooks/plaid, e.g.:
#   https://your-app.up.railway.app/webhooks/plaid
PLAID_WEBHOOK_URL=

# ── DealTough integration (savings/negotiation) ──────────
# Base URL of the DealTough deployment — DoerToughMoney calls out to it for
# "should I buy this" purchase analysis (see server/dealtough.js). Leave unset
# to disable the /api/dealtough/analyze route.
DEALTOUGH_API_URL=

# ── Sign in with Google ──────────────────────────────────
# From https://console.cloud.google.com/apis/credentials — create an OAuth
# client ID of type "Web application". Only the Client ID is needed (it's
# public, sent to the browser); this uses Google's ID-token verification, not
# the authorization-code flow, so there's no client secret to protect.
# Add both your local and production origins under "Authorized JavaScript
# origins" on that credential. Leave unset to hide the "Sign in with Google"
# button entirely; password accounts are unaffected either way.
GOOGLE_CLIENT_ID=

# ── Face ID / Touch ID (passkeys) ────────────────────────
# No credentials needed — WebAuthn runs entirely against this app's own
# domain. RP_ID/expected origin are derived from WEB_ORIGIN above, so nothing
# else to configure. Passkeys are additive: existing password (and Google)
# accounts are unaffected.
