# ── Server ──────────────────────────────────────────────
PORT=4000
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
WEB_ORIGIN=http://localhost:5173

# ── Database (Postgres) ─────────────────────────────────
# Local docker:  docker run --name even-pg -e POSTGRES_PASSWORD=pg -p 5432:5432 -d postgres:16
# Then:          DATABASE_URL="postgresql://postgres:pg@localhost:5432/even?schema=public"
# On Railway this is provided automatically by the Postgres plugin.
DATABASE_URL=postgresql://postgres:pg@localhost:5432/even?schema=public

# ── Dwolla ──────────────────────────────────────────────
# Sandbox keys from https://dashboard-sandbox.dwolla.com/applications
DWOLLA_KEY=your_sandbox_key_here
DWOLLA_SECRET=your_sandbox_secret_here
DWOLLA_ENV=sandbox            # "production" once approved for real money movement
# The secret you set when creating the webhook subscription in the Dwolla dashboard.
DWOLLA_WEBHOOK_SECRET=whsec_xxx

# ── Fees (revenue) ──────────────────────────────────────
# Both fees are charged to the SENDER and auto-credit your Dwolla Master
# Account Balance. The recipient always receives the full amount.

# Base fee on EVERY payment. Leave at 0 to keep standard sends free — a fee on
# friend-to-friend sends is where users push back hardest.
PLATFORM_FEE_BPS=0            # basis points; 150 = 1.5%
PLATFORM_FEE_FLAT_CENTS=0     # flat add-on per payment, in cents
# PLATFORM_FEE_CAP_CENTS=1000 # optional max fee per payment, in cents

# Optional faster-delivery upgrade, charged only when the sender picks Express
# (Same Day ACH, plus Instant Payments when the recipient's bank supports it).
# This is the fee users pay most willingly, since it's opt-in for visible value.
# Express is hidden from the UI entirely unless one of these is above 0.
EXPEDITE_FEE_BPS=175          # basis points; 175 = 1.75%
EXPEDITE_FEE_FLAT_CENTS=0     # flat add-on, in cents
# EXPEDITE_FEE_CAP_CENTS=1500 # optional max expedite fee, in cents

# Instant Payments (RTP/FedNow). Requires Real Time Payments to be enabled on
# your Dwolla ACCOUNT — request it from Dwolla; a recipient bank advertising the
# real-time-payments channel is not enough on its own. Until it's granted,
# leave this false and Express delivers via Same Day ACH.
DWOLLA_RTP_ENABLED=false

# ── Instant bank linking (Open Banking) ──────────────────
# Instant Account Verification runs through Dwolla's Open Banking Services,
# which brokers Plaid on your behalf — NO separate Plaid account, contract, or
# API keys needed; it uses the Dwolla credentials above.
#
# It DOES require Open Banking scopes on your Dwolla application, granted per
# account. Until Dwolla enables them, exchange sessions fail with 401
# InvalidScope, so this stays off and users link banks via the manual
# routing/account + micro-deposit path (1-2 business days).
# Ask Dwolla to enable Open Banking, then set this to true.
DWOLLA_OPEN_BANKING_ENABLED=false
