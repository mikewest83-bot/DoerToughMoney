# Copy this to .env for local development and fill in real values.
# On Railway, set these under the service's Variables tab instead — .env
# files aren't used there.

# ── Core ──────────────────────────────────────────────────
# Postgres connection string. Railway provides this automatically when a
# Postgres plugin is attached to the service.
DATABASE_URL=

# Signs auth tokens — must be at least 32 random characters. Generate one
# with e.g. `openssl rand -base64 32`. Never reuse this across environments.
JWT_SECRET=

# The frontend's own origin (used for CORS, and for WebAuthn's RP_ID /
# expected origin — see the passkey note below). Local dev: http://localhost:5173.
# Production: https://app.doertough.com (no trailing slash).
WEB_ORIGIN=http://localhost:5173

NODE_ENV=development

# Set to "false" to explicitly disable serving the built frontend from this
# service (e.g. if it's ever split into its own service). Leave unset
# otherwise — the app now serves web/dist whenever a build is actually
# present there, rather than requiring this to be set to anything truthy.
SERVE_WEB=

# ── Linked banks (Plaid) ──────────────────────────────────
# From https://dashboard.plaid.com/team/keys. Leave both unset to disable
# bank linking — the rest of the app still works, /api/config will report
# plaidEnabled: false, and the UI hides the "Link a bank" flow accordingly.
PLAID_CLIENT_ID=
PLAID_SECRET=

# "sandbox" | "development" | "production" — defaults to sandbox if unset.
# Must be "production" to link real banks.
PLAID_ENV=

# This service's own /webhooks/plaid endpoint, e.g.
# https://<your-app>.up.railway.app/webhooks/plaid. Optional — without it,
# the app still works, but only picks up new transactions on a manual
# /api/plaid/sync call rather than Plaid pushing updates automatically.
PLAID_WEBHOOK_URL=

# ── DealTough integration ────────────────────────────────
# Base URL of the DealTough deployment — DoerToughMoney calls out to it for
# "should I buy this" purchase analysis (see server/dealtough.js). Leave unset
# to disable the /api/dealtough/analyze route.
DEALTOUGH_API_URL=

# ── Sign in with Google ──────────────────────────────────
# From https://console.cloud.google.com/apis/credentials — create an OAuth
# client ID of type "Web application". Only the Client ID is needed (it's
# public, sent to the browser); this uses Google's ID-token verification, not
# the authorization-code flow, so there's no client secret to protect.
# Add both your local and production origins under "Authorized JavaScript
# origins" on that credential. Leave unset to hide the "Sign in with Google"
# button entirely; password accounts are unaffected either way.
GOOGLE_CLIENT_ID=

# ── Face ID / Touch ID (passkeys) ────────────────────────
# No credentials needed — WebAuthn runs entirely against this app's own
# domain. RP_ID/expected origin are derived from WEB_ORIGIN above, so nothing
# else to configure. Passkeys are additive: existing password (and Google)
# accounts are unaffected.

# ── Billing (Stripe subscriptions) ───────────────────────
# From https://dashboard.stripe.com/apikeys — the SECRET key (not the
# publishable one; nothing Stripe-related runs in the browser here, Checkout
# and the Customer Portal are both Stripe-hosted redirects).
STRIPE_SECRET_KEY=

# The monthly Pro plan's Price ID (starts with price_), from
# https://dashboard.stripe.com/products — create the product/price there
# first. Leave unset to disable /api/billing/checkout and hide upgrade UI.
STRIPE_PRICE_ID=

# From the webhook endpoint's settings page after creating it at
# https://dashboard.stripe.com/webhooks, pointed at
# https://<your-app>/webhooks/stripe. Subscribe it to: checkout.session.completed,
# customer.subscription.created, customer.subscription.updated,
# customer.subscription.deleted. Leave unset and the webhook route 503s —
# checkout will still start, but subscription status will never update.
STRIPE_WEBHOOK_SECRET=
